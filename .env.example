# Private runtime artifacts. Relative paths are resolved from the API process directory.
THREECRAFT_DATA_DIR=.threecraft-data

# deterministic-dev is a local procedural illustration provider, not an AI service.
# Use null to disable generation until an approved real provider adapter is configured.
THREECRAFT_IMAGE_PROVIDER=deterministic-dev

# Frontend uses the Vite /api proxy by default. Set only for separately hosted deployments.
# VITE_API_BASE_URL=http://127.0.0.1:8000
